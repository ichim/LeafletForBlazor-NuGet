@page "/"
@using Data.Input

<Map 
    loadParameters="@loadParameters" 
    height="calc(100vh - 2rem)" 
    width="calc(100vw - 2rem)" 
    OnAfterMapLoaded="@OnAfterMapLoaded" />

@code {
    LoadParameters loadParameters = new LoadParameters()
    {
        location = new Location()                                               //Center of the Map View
        {
            latitude =50.951451266515306,
            longitude = 3.986288916944186
        },
        zoomLevel = 8,
        mapControls = new MapControls()
        {
            layerList = new LayerList() { position = Position.topRight },       //Layer List Control
            scaleBar = new ScaleBar()                                           //Map Scale Bar
            {
                position = Position.bottomRight,
                unitOfScaleBar = UnitOfScaleBar.metric
            },

        }
    };

    private async Task OnAfterMapLoaded(MapEventArgs args)
    {
        var map = args.sender as Map;
        if (map?.Geometric?.Points != null)
        {
            await map.Geometric.Points.Add(new StreamPoints().points);
        }
    }
}
