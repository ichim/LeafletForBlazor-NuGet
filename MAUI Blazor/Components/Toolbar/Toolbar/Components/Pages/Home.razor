@page "/"

<Map @ref="map"
     loadParameters="@loadParameters"
     height="calc(100vh)"
     width="calc(100vw)">
    <MapComponents>
        <Toolbar left="48px" top="12px">
            <button @onclick="@ZoomIn" title="Zoom in">＋</button>
            <button @onclick="@ZoomOut" title="Zoom out">－</button>
            <button @onclick="@ToggleLayer" title="Toggle basemap Topo and EsriImagery">🗺</button>
        </Toolbar>
    </MapComponents>
</Map>

@code {
    Map? map = null;


    LoadParameters loadParameters = new LoadParameters()
    {
        location = new Location()                                               //Center of the Map View
        {
            latitude = 50.83112274500208,
            longitude = 4.407353347319803
        },
        zoomLevel = 10,
        basemapLayers = new List<BasemapLayer>()
        {
            new BasemapLayer()
            {
                 title = "Topo",
                url = "https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png"
            },
    new BasemapLayer()
            {
                 title = "EsriImagery",
                url = "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
            },

        }
    };
    private async Task ZoomIn()
    {
        if (map?.View != null)
        {
            var currentZoom = await map.View.getZoomLevelAsync();
            map.View.SetZoomLevel(currentZoom + 1);
        }
    }

    private async Task ZoomOut()
    {
        if (map?.View != null)
        {
            var currentZoom = await map.View.getZoomLevelAsync();
            map.View.SetZoomLevel(currentZoom - 1);
        }
    }
    List<string> basemaps = new List<string> { "Topo", "EsriImagery" };
    int basemapId = 0;
    private void ToggleLayer()
    {
        basemapId = (basemapId + 1) % basemaps.Count;
        map!.View.SetBasemapLayer(basemaps[basemapId]); 
    }
}
