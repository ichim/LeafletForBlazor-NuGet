@page "/"
@using Data.Input



<Map
     loadParameters="@loadParameters"
     height="calc(100vh - 1rem)"
     width="calc(100vw - 2rem)"
     OnAfterMapLoaded="@OnAfterMapLoaded">
     <MapComponents>
        <MapPopup @ref="mapPopup" className="@mapPopupClass">
            <HeaderContent>
                @if (points.Count != 0)
                {
                    <h6 style="margin-top:0px;margin-bottom:0px;">Attributes</h6>
                }
                else
                {
                    <h6 style="margin-top:0px;margin-bottom:0px;">Coordinates</h6>
                }

            </HeaderContent>
            <PopupContent>
                @{
                    @if (points.Count != 0)
                    {
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var point in points)
                            {
                                <label style="font-weight:800;color:darkblue">@point.type</label>
                
                           
                                    <div class="card-body">
                                        @if (point.value is string)
                                        {
                                            <p class="card-text mb-0">@point.value</p>
                                        }
                                        else if (point.value is DroneTrak dtProps)
                                        {
                                        <table class="table table-sm" style="background-color:#FFFFE0">
                                                <tbody>
                                                    <tr>
                                                        <td class="fw-semibold">Fuel:</td>
                                                        <td>@dtProps?.fuel</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="fw-semibold">Altitude:</td>
                                                        <td>@dtProps?.altitude</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="fw-semibold">Battery:</td>
                                                        <td>@dtProps?.battery</td>
                                                    </tr>
                                                    <tr>
                                                        <td class="fw-semibold">Battery level:</td>
                                                        <td>@dtProps?.battery %</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        }
                                    </div>
                            
                            }
                        </div>
                    }

                    else
                    {
                        <label>Latitude: </label>
                        <label>@lat</label>

                        <br />
                        <label>Longitude: </label>
                        <label>@lng</label>
                    }
                }
            </PopupContent>
        </MapPopup>
    </MapComponents>
</Map>

@code {
    double lat = 0;
    double lng = 0;
    List<StreamPoint> points = new List<StreamPoint>();

    private MapPopup? mapPopup;
    private string mapPopupClass = "popup-cheerful";
    LoadParameters loadParameters = new LoadParameters()
    {
        location = new Location()                                             
        {
            latitude = 50.83112274500208,
            longitude = 4.407353347319803
        },

        zoomLevel = 10,
    };
    private async Task OnAfterMapLoaded(MapEventArgs args)
    {
        var map = args.sender as Map;

        if (map?.Geometric?.Points != null)
        {
            
            map.Geometric.Points.OnClick += (sender, args) =>
            {
                points = args.points;
                mapPopup?.Show(args, 200, 200);
                lat = Math.Round(args.geoid.xy[0], 4);
                lng = Math.Round(args.geoid.xy[1], 4);
                if (points.Count == 0)
                {
                    mapPopupClass = "popup-coordinates";
                }
                else
                {
                    mapPopupClass = "popup-cheerful";
                }
            };
        }
        await map.Geometric.Points.Add(new StreamPoints().points);
        await map.Geometric.Points.Appearance(e => e.type == "SigmaDrone").SetStyle(new PointStyle()
        {
            color = "orange",
            fillColor = "yellow",
            weight = 1,
            radius = 4,
            visibilityZoomLevels = new VisibilityZoomLevels() { minZoomLevel = 0, maxZoomLevel = 100 },
            title = "Sigma Drone"
        });

        await map.Geometric.Points.Appearance(e => e.type == "Industrial").SetStyle(new PointIcon()
        {
            iconUrl = "http://localhost:5175/icons/Industrial.png",
            iconSize = new double[2] { 16, 16 },
            iconAnchor = new double[2] { 8, 8 },
            // rotation = 90,

            title = "Industrial"
        });
        await map.Geometric.Points.Appearance(e => e.type == "Auto").SetStyle(new PointStyle()
        {
            color = "green",
            fillColor = "indigo",
            weight = 1,
            radius = 4,
            visibilityZoomLevels = new VisibilityZoomLevels() { minZoomLevel = 0, maxZoomLevel = 100 },
            title = "Auto"
        });
        await map.Geometric.Points.Appearance(e => e.type == "Deposit").SetStyle(new PointStyle()
        {
            color = "black",
            fillColor = "red",
            weight = 1,
            radius = 4,
            visibilityZoomLevels = new VisibilityZoomLevels() { minZoomLevel = 0, maxZoomLevel = 100 },
            title = "Deposit"
        });
       
    }
}
