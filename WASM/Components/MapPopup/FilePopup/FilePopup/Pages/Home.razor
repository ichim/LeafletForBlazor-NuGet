@page "/"
@using System.Dynamic
@using LeafletForBlazor.MapComponents
@inject NavigationManager NavigationManager


<Map @ref="map"
     loadParameters="@loadParameters"
     height="calc(100vh)"
     width="calc(100vw)"
     OnAfterMapLoaded="@OnAfterMapLoaded" workingWithBootstrap="true">
    <Legend left="12px" top="80px"><HeaderContent><h6 style="margin-block-start:0.20em;margin-block-end:0.20em">Legend</h6></HeaderContent><FooterContent><label style="font-size:8px;font-style:italic;font-weight:100">You can add explanations.</label></FooterContent></Legend>
    <MapPopup @ref="myPopup">
        <HeaderContent >
            <h6>Attributes</h6>
        </HeaderContent>
        <PopupContent>
            <table>
                <tbody>
                    @foreach (var item in table)
                    {
                        <tr>
                            <td style="width:100%">@item.Key</td>
                            <td>@item.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </PopupContent>

    </MapPopup>
</Map>

@code {
    Map? map = null;
    private MapPopup? myPopup;
    Dictionary<string, string> table = new Dictionary<string, string>();
    LoadParameters loadParameters = new LoadParameters()
    {

        location = new Location()                                               //Center of the Map View
        {
            latitude = 44.444941,
            longitude = 26.097369
        },
        zoomLevel = 16
    };


    private async Task OnAfterMapLoaded(MapEventArgs args)
    {
        var map = args.sender as Map;
        if (map?.Geometric.From.Files != null)
        {

            var path = NavigationManager.Uri;


            map.Geometric.From.Files.OnClick += (sender, args) =>
            {

                Console.WriteLine($" {(args as FilesAndObjectsItemsEventArgs).geometriesFound.Count}");

                foreach (ExpandoObject item in (args as FilesAndObjectsItemsEventArgs).geometriesFound)
                {
                    if (item is IDictionary<string, object> dict)
                    {
                        table = new Dictionary<string, string>();
                        foreach (var key in dict.Keys)
                        {
                            if (key == "properties")
                            {
                                var value = dict[key];

                                if (value is IDictionary<string, object> propertiesDict)
                                {
                                    foreach (var propKey in propertiesDict.Keys)
                                    {
                                        var propValue = propertiesDict[propKey];
                                        table.Add(propKey, propValue?.ToString() ?? string.Empty);

                                    }
                                }

                            }
                        }
                    }
                }

                if ((args as FilesAndObjectsItemsEventArgs).geometriesFound.Count != 0)
                    myPopup?.Show(args, 200, 200);
                else
                    myPopup?.HidePopup();
            };
            map.Geometric.From.Files.forceCacheIgnore = true;

            await map.Geometric.From.Files.FetchAsync(new List<string> { $"{path}/data/tooltips-area.json" });



        }
    }


}