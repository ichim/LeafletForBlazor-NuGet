@page "/"
@using System.Dynamic
@using LeafletForBlazor.MapComponents
@inject NavigationManager NavigationManager


<Map @ref="map"
     loadParameters="@loadParameters"
     height="calc(100vh)"
     width="calc(100vw)"
     OnAfterMapLoaded="@OnAfterMapLoaded" workingWithBootstrap="true">
    
</Map>

@code {
    Map? map = null;
    private MapPopup? myPopup;
    Dictionary<string, string> table = new Dictionary<string, string>();
    LoadParameters loadParameters = new LoadParameters()
    {

        location = new Location()                                               //Center of the Map View
        {
            latitude = 44.444941,
            longitude = 26.097369
        },
        zoomLevel = 16
    };


    private async Task OnAfterMapLoaded(MapEventArgs args)
    {
        var map = args.sender as Map;
        if (map?.Geometric.From.Files != null)
        {

            var path = NavigationManager.Uri;
            map.Geometric.From.Files.forceCacheIgnore = true;

            await map.Geometric.From.Files.FetchAsync(new List<string> { $"{path}/data/tooltips-area.json" });



        }
    }


}